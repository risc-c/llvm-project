; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt < %s -passes=instsimplify -S | FileCheck %s --check-prefix=CHECK
; RUN: opt < %s -data-layout="E-p:64:64:64-p1:16:16:16-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64" -passes=instsimplify -S | FileCheck %s --check-prefix=CHECK

target datalayout = "e-p:64:64:64-p1:16:16:16-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64"

; Scalar element types.
@g_i8 = private constant [4 x i8] [i8 7, i8 7, i8 7, i8 7]
@g_i16 = private constant [4 x i16] [i16 1234, i16 1234, i16 1234, i16 1234]
@g_i32 = private constant [4 x i32] [i32 305419896, i32 305419896, i32 305419896, i32 305419896]
@g_i64 = private constant [4 x i64] [i64 123456789, i64 123456789, i64 123456789, i64 123456789]
@g_float = private constant [4 x float] [float 1.250000e+00, float 1.250000e+00, float 1.250000e+00, float 1.250000e+00]

define i8 @typed_i8(i64 %idx) {
; CHECK-LABEL: @typed_i8(
; CHECK-NEXT:    ret i8 7
  %p = getelementptr inbounds [4 x i8], ptr @g_i8, i64 0, i64 %idx
  %v = load i8, ptr %p
  ret i8 %v
}

define i16 @typed_i16(i64 %idx) {
; CHECK-LABEL: @typed_i16(
; CHECK-NEXT:    ret i16 1234
  %p = getelementptr inbounds [4 x i16], ptr @g_i16, i64 0, i64 %idx
  %v = load i16, ptr %p
  ret i16 %v
}

define i32 @typed_i32(i64 %idx) {
; CHECK-LABEL: @typed_i32(
; CHECK-NEXT:    ret i32 305419896
  %p = getelementptr inbounds [4 x i32], ptr @g_i32, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

define i64 @typed_i64(i64 %idx) {
; CHECK-LABEL: @typed_i64(
; CHECK-NEXT:    ret i64 123456789
  %p = getelementptr inbounds [4 x i64], ptr @g_i64, i64 0, i64 %idx
  %v = load i64, ptr %p
  ret i64 %v
}

define float @typed_float(i64 %idx) {
; CHECK-LABEL: @typed_float(
; CHECK-NEXT:    ret float 1.250000e+00
  %p = getelementptr inbounds [4 x float], ptr @g_float, i64 0, i64 %idx
  %v = load float, ptr %p
  ret float %v
}

; A byte GEP is valid when its variable offset is known to be an element
; stride.  The first form gets that fact from a shift; the second gets it
; from known low zero bits of the index.
define i16 @byte_gep_shifted_index(i64 %idx) {
; CHECK-LABEL: @byte_gep_shifted_index(
; CHECK-NEXT:    ret i16 1234
  %off = shl i64 %idx, 1
  %p = getelementptr inbounds i8, ptr @g_i16, i64 %off
  %v = load i16, ptr %p
  ret i16 %v
}

define i16 @byte_gep_known_even_index(i64 %raw) {
; CHECK-LABEL: @byte_gep_known_even_index(
; CHECK-NEXT:    ret i16 1234
  %off = and i64 %raw, -2
  %p = getelementptr inbounds i8, ptr @g_i16, i64 %off
  %v = load i16, ptr %p
  ret i16 %v
}

; Nested repeated arrays and a pair of cancelling constant GEPs.
@g_nested = private constant [3 x [2 x i32]] [[2 x i32] [i32 77, i32 77], [2 x i32] [i32 77, i32 77], [2 x i32] [i32 77, i32 77]]
@g_chain = private constant [8 x i32] [i32 91, i32 91, i32 91, i32 91, i32 91, i32 91, i32 91, i32 91]

define i32 @nested_array(i64 %outer, i64 %inner) {
; CHECK-LABEL: @nested_array(
; CHECK-NEXT:    ret i32 77
  %p = getelementptr inbounds [3 x [2 x i32]], ptr @g_nested, i64 0, i64 %outer, i64 %inner
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @cancelled_offsets(i64 %idx) {
; CHECK-LABEL: @cancelled_offsets(
; CHECK-NEXT:    ret i32 91
  %p0 = getelementptr inbounds [8 x i32], ptr @g_chain, i64 0, i64 %idx
  %p1 = getelementptr inbounds i32, ptr %p0, i64 1
  %p2 = getelementptr inbounds i32, ptr %p1, i64 -1
  %v = load i32, ptr %p2
  ret i32 %v
}

@g_weak_odr = weak_odr constant [4 x i32] [i32 17, i32 17, i32 17, i32 17]

define i32 @weak_odr_array(i64 %idx) {
; CHECK-LABEL: @weak_odr_array(
; CHECK-NEXT:    ret i32 17
  %p = getelementptr inbounds [4 x i32], ptr @g_weak_odr, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

; Different elements are not a splat.
@g_mixed = private constant [4 x i32] [i32 7, i32 8, i32 7, i32 7]

define i32 @mixed_values(i64 %idx) {
; CHECK-LABEL: @mixed_values(
; CHECK:       load i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_mixed, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

; These globals are not immutable definitive objects for this transform.
@g_mutable = global [4 x i32] [i32 19, i32 19, i32 19, i32 19]
@g_weak = weak constant [4 x i32] [i32 23, i32 23, i32 23, i32 23]
@g_external_init = internal externally_initialized constant [4 x i32] [i32 29, i32 29, i32 29, i32 29]

define i32 @mutable_global(i64 %idx) {
; CHECK-LABEL: @mutable_global(
; CHECK:       load i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_mutable, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @weak_global(i64 %idx) {
; CHECK-LABEL: @weak_global(
; CHECK:       load i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_weak, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @externally_initialized_global(i64 %idx) {
; CHECK-LABEL: @externally_initialized_global(
; CHECK:       load i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_external_init, i64 0, i64 %idx
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @volatile_load(i64 %idx) {
; CHECK-LABEL: @volatile_load(
; CHECK:       load volatile i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_i32, i64 0, i64 %idx
  %v = load volatile i32, ptr %p
  ret i32 %v
}

define i32 @atomic_load(i64 %idx) {
; CHECK-LABEL: @atomic_load(
; CHECK:       load atomic i32, ptr
; CHECK:       ret i32
  %p = getelementptr inbounds [4 x i32], ptr @g_i32, i64 0, i64 %idx
  %v = load atomic i32, ptr %p unordered, align 4
  ret i32 %v
}

; A byte offset without a provable low bit, or with a known misaligned low
; bit, cannot select an i16 element boundary.
define i16 @byte_gep_unknown_offset(i64 %off) {
; CHECK-LABEL: @byte_gep_unknown_offset(
; CHECK:       load i16, ptr
; CHECK:       ret i16
  %p = getelementptr inbounds i8, ptr @g_i16, i64 %off
  %v = load i16, ptr %p
  ret i16 %v
}

define i16 @byte_gep_misaligned_offset(i64 %raw) {
; CHECK-LABEL: @byte_gep_misaligned_offset(
; CHECK:       load i16, ptr
; CHECK:       ret i16
  %off = or i64 %raw, 1
  %p = getelementptr inbounds i8, ptr @g_i16, i64 %off
  %v = load i16, ptr %p
  ret i16 %v
}

; The requested type must be an array element type, not merely a smaller
; integer that happens to fit at the same address.
define i16 @mismatched_load_type(i64 %idx) {
; CHECK-LABEL: @mismatched_load_type(
; CHECK:       load i16, ptr
; CHECK:       ret i16
  %p = getelementptr inbounds [4 x i32], ptr @g_i32, i64 0, i64 %idx
  %v = load i16, ptr %p
  ret i16 %v
}

; The element allocation size is 12 bytes (including padding), so it is not a
; supported power-of-two load stride for this transform.
%padded = type { i8, i32, i8 }
@g_padded = private constant [2 x %padded] [%padded { i8 1, i32 2, i8 3 }, %padded { i8 1, i32 2, i8 3 }]

define %padded @struct_padding(i64 %idx) {
; CHECK-LABEL: @struct_padding(
; CHECK:       load %padded, ptr
; CHECK:       ret %padded
  %p = getelementptr inbounds [2 x %padded], ptr @g_padded, i64 0, i64 %idx
  %v = load %padded, ptr %p
  ret %padded %v
}

; This exercises a non-default 16-bit address-space index width.
@g_narrow_index = private addrspace(1) constant [4 x i32] [i32 41, i32 41, i32 41, i32 41]

define i32 @narrow_address_space_index(i16 %idx) {
; CHECK-LABEL: @narrow_address_space_index(
; CHECK-NEXT:    ret i32 41
  %p = getelementptr inbounds [4 x i32], ptr addrspace(1) @g_narrow_index, i16 0, i16 %idx
  %v = load i32, ptr addrspace(1) %p
  ret i32 %v
}

; An address-space cast is deliberately outside the GEP-only offset walk.
define i32 @address_space_cast_not_folded(i16 %idx) {
; CHECK-LABEL: @address_space_cast_not_folded(
; CHECK:       load i32, ptr
; CHECK:       ret i32
  %q = getelementptr inbounds [4 x i32], ptr addrspace(1) @g_narrow_index, i16 0, i16 %idx
  %p = addrspacecast ptr addrspace(1) %q to ptr
  %v = load i32, ptr %p
  ret i32 %v
}
