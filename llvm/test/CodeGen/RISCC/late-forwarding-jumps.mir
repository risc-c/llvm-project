# REQUIRES: riscc-registered-target
# RUN: split-file %s %t
# RUN: %python %t/generate.py 16 > %t/rc16.mir
# RUN: %python %t/generate.py 32 > %t/rc32.mir
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-constant-islands -verify-machineinstrs %t/rc16.mir -o - | \
# RUN:   FileCheck %s
# RUN: llc -mtriple=riscc -mcpu=nano -run-pass=riscc-constant-islands -verify-machineinstrs %t/rc16.mir -o - | \
# RUN:   FileCheck %s
# RUN: llc -mtriple=riscc -mcpu=full -mattr=+rc32 -run-pass=riscc-constant-islands -verify-machineinstrs %t/rc32.mir \
# RUN:   -o - | FileCheck %s

# CHECK-LABEL: name: thread_jump
# CHECK:       BNEZ %bb.3
# CHECK:       bb.2:
# CHECK:       $r1 = LDI{{(32)?}} 0
# CHECK-NOT:   JMP8
# CHECK:       bb.3:

# Do not redirect a layout fallthrough, delete an address-taken label, or turn
# a compact branch into an out-of-range branch. The original short stub is
# useful in the last case.
# CHECK-LABEL: name: keep_fallthrough
# CHECK:       bb.2:
# CHECK:       JMP8 %bb.4
# CHECK-LABEL: name: keep_address
# CHECK:       bb.2 (machine-block-address-taken):
# CHECK:       JMP8 %bb.4
# CHECK-LABEL: name: keep_range
# CHECK:       bb.2:
# CHECK:       JMP8 %bb.4

#--- generate.py
import sys

width = int(sys.argv[1])
ldi = 'LDI32' if width == 32 else 'LDI'
names = ('thread_jump', 'keep_fallthrough', 'keep_address', 'keep_range')
print('--- |')
for name in names:
    print(f'  define void @{name}() {{ ret void }}')
print('...')
for name in names:
    print(f'''---
name: {name}
alignment: 2
tracksRegLiveness: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    $r0 = {ldi} 1
    BNEZ %bb.2, implicit $r0
    JMP8 %bb.1
  bb.1:''')
    if name == 'keep_fallthrough':
        print(f'''    successors: %bb.2
    $r1 = {ldi} 2''')
    else:
        print(f'''    successors: %bb.3, %bb.4
    $r0 = {ldi} 2
    BNEZ %bb.3, implicit $r0
    JMP8 %bb.4''')
    address = ' (machine-block-address-taken)' if name == 'keep_address' else ''
    print(f'''  bb.2{address}:
    successors: %bb.4
    JMP8 %bb.4
  bb.3:
    successors: %bb.4
    $r1 = {ldi} 0''')
    if name == 'keep_range':
        for _ in range(125):
            print(f'    $r1 = {ldi} 0')
    print('''  bb.4:
    RETS implicit $s7
...''')
