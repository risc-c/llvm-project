# REQUIRES: riscc-registered-target
# RUN: split-file %s %t
# RUN: %python %t/generate.py > %t/input.mir
# RUN: llc -mtriple=riscc -mcpu=min -mattr=+rc32 -O0 -start-before=prolog-epilog -verify-machineinstrs %t/input.mir \
# RUN:   -o - | FileCheck %s --check-prefixes=CHECK,RC32
# RUN: llc -mtriple=riscc -mcpu=min -mattr=+rc32 -O0 -start-before=prolog-epilog -verify-machineinstrs -filetype=obj \
# RUN:   %t/input.mir -o %t/rc32.o
# RUN: sed -e 's/FRAMEADDR32/FRAMEADDR/g' -e 's/ST32/ST/g' -e 's/alignment: 4/alignment: 2/g' %t/input.mir > %t/rc16.mir
# RUN: llc -mtriple=riscc -mcpu=min -O0 -start-before=prolog-epilog -verify-machineinstrs %t/rc16.mir -o - | \
# RUN:   FileCheck %s --check-prefixes=CHECK,RC16
# RUN: llc -mtriple=riscc -mcpu=min -O0 -start-before=prolog-epilog -verify-machineinstrs -filetype=obj %t/rc16.mir \
# RUN:   -o %t/rc16.o

# The frame is small and no memory instruction has an FI operand. Computing
# distant addresses from it must still count toward the
# branch estimate, including the RC32 literals that FI elimination introduces.
# Every GPR is live at the branch target, requiring a spill for the far jump.
# CHECK-LABEL: large_frame_addresses:
# CHECK: st r0, [r7 + 0]
# RC32-NEXT: ldpc r0,
# RC16-NEXT: ldi16 r0,
# CHECK-NEXT: jalr s0, r0
# CHECK: ld r0, [r7 + 0]

#--- generate.py
print("""---
name: large_frame_addresses
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: default, size: 4, alignment: 4 }
body: |
  bb.0:
    successors: %bb.2
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $s7
    JMP8 %bb.2
  bb.1:
    liveins: $s7
""")
for n in range(35):
    print(f"    $r1 = FRAMEADDR32 %stack.0, {300 + n * 4}")
    print("    ST32 killed $r1, $r7, 0")
print("""    RETS implicit $s7
  bb.2:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $s7
    RETS implicit $s7, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6
...
""")
