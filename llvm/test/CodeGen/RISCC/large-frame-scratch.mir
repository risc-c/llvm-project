# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc-none-elf -mcpu=full -run-pass=prolog-epilog %s -o - | FileCheck %s

# A killed store source is free immediately after the store, which is where
# RegScavenger's liveness cursor sits during backwards frame-index elimination.
# It must nevertheless be excluded from the address scratch chosen for code
# inserted before the store.  Check the corresponding load while here too.
# CHECK-LABEL: name: large_frame_spill
# CHECK:       $r0 = LI 202
# CHECK-NEXT:  $r0 = ADD $r7, killed $r0
# CHECK-NEXT:  STW killed $r1, $r0, 0
# CHECK-NEXT:  $r0 = LI 202
# CHECK-NEXT:  $r0 = ADD $r7, killed $r0
# CHECK-NEXT:  $r1 = LDW $r0, 0

--- |
  target triple = "riscc-none-elf"

  define i16 @large_frame_spill(i16 %value) {
  entry:
    ret i16 %value
  }
...
---
name:            large_frame_spill
alignment:       2
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  maxAlignment:  2
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 2, alignment: 2,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true }
  - { id: 1, name: '', type: default, offset: 0, size: 200, alignment: 2,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true }
body:             |
  bb.0.entry:
    liveins: $r1

    STW killed $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    $r1 = LDW %stack.0, 0 :: (load (s16) from %stack.0)
    RETS implicit $s7, implicit killed $r1
...
