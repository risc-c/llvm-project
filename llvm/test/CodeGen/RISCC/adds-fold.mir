# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -mattr=+adds -run-pass=riscc-postra-optimize -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/\bADD\b/ADD32/g' %s | llc -x mir -mtriple=riscc -mcpu=full -mattr=+rc32,+adds -run-pass=riscc-postra-optimize -verify-machineinstrs -o - | FileCheck %s
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-postra-optimize -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=OFF
# RUN: llc -mtriple=riscc -mcpu=nano -mattr=+adds -run-pass=riscc-postra-optimize -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=OFF --implicit-check-not=ADDS

# CHECK-LABEL: name: scheduled
# CHECK-NOT: MFS
# CHECK: $r2 = ADD{{(32)?}} {{.*}}$r3, {{.*}}$r4
# CHECK: $r1 = ADDS{{(32)?}} {{.*}}$r2, {{.*}}$s2
# OFF-LABEL: name: scheduled
# OFF: MFS
# OFF-NOT: ADDS
# OFF: RETS
# CHECK-LABEL: name: repeated
# CHECK-NOT: MFS
# CHECK: $r1 = ADDS{{(32)?}} {{.*}}$r3, {{.*}}$s2
# CHECK: $r2 = ADDS{{(32)?}} {{.*}}$r4, {{.*}}$s2
# CHECK-LABEL: name: other_use
# CHECK: MFS
# CHECK-NOT: ADDS
# CHECK: RETS
# CHECK-LABEL: name: source_changed
# CHECK: MFS
# CHECK-NOT: ADDS
# CHECK: RETS
# CHECK-LABEL: name: both_inputs
# CHECK: MFS
# CHECK-NOT: ADDS
# CHECK: RETS
# CHECK-LABEL: name: live_result
# CHECK: MFS
# CHECK-NOT: ADDS
# CHECK: RETS
# A source S register may be overwritten after its last ADD consumer when the
# old GPR value is dead at the block exit.
# CHECK-LABEL: name: source_dead_after_add
# CHECK-NOT: MFS
# CHECK: $r1 = ADDS{{(32)?}} {{.*}}$r3, {{.*}}$s2
# CHECK: $s2 = MTS{{.*}}$r4
# CHECK: RETS
# A later read of the old GPR value keeps the whole transfer un-foldable.
# CHECK-LABEL: name: source_live_after_clobber
# CHECK: $r0 = MFS $s2
# CHECK-NOT: ADDS
# CHECK: $s2 = MTS{{.*}}$r4
# CHECK: $r2 = ADD{{(32)?}} {{.*}}$r0
# CHECK: RETS

--- |
  target triple = "riscc-none-elf"
  define void @scheduled() { ret void }
  define void @repeated() { ret void }
  define void @other_use() { ret void }
  define void @source_changed() { ret void }
  define void @both_inputs() { ret void }
  define void @live_result() { ret void }
  define void @source_dead_after_add() { ret void }
  define void @source_live_after_clobber() { ret void }
...
---
name: scheduled
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $r4, $s7
    $r1 = MFS $s2
    $r2 = ADD $r3, $r4
    $r1 = ADD $r1, $r2
    RETS implicit $s7, implicit $r1
...
---
name: repeated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $r4, $s7
    $r0 = MFS $s2
    $r1 = ADD $r3, $r0
    $r2 = ADD $r0, $r4
    RETS implicit $s7, implicit $r1, implicit $r2
...
---
name: other_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $s7
    $r0 = MFS $s2
    $r1 = ADD $r3, $r0
    $r2 = SUB $r0, $r3
    RETS implicit $s7, implicit $r1, implicit $r2
...
---
name: source_changed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $s7
    $r0 = MFS $s2
    $s2 = MTS $r3
    $r1 = ADD $r0, $r3
    RETS implicit $s7, implicit $r1
...
---
name: both_inputs
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $s7
    $r0 = MFS $s2
    $r1 = ADD $r0, $r0
    RETS implicit $s7, implicit $r1
...
---
name: live_result
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $s7
    $r0 = MFS $s2
    $r1 = ADD $r0, $r3
    RETS implicit $s7, implicit $r0, implicit $r1
...
---
name: source_dead_after_add
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $r4, $s7
    $r0 = MFS $s2
    $r1 = ADD $r3, $r0
    $s2 = MTS $r4
    RETS implicit $s7, implicit $r1
...
---
name: source_live_after_clobber
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s2, $r3, $r4, $r5, $s7
    $r0 = MFS $s2
    $r1 = ADD $r3, $r0
    $s2 = MTS $r4
    $r2 = ADD $r5, $r0
    RETS implicit $s7, implicit $r1, implicit $r2
...
