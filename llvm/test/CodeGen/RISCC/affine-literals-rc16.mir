# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-postra-optimize -verify-machineinstrs %s -o - | FileCheck %s \
# RUN:   --check-prefixes=CHECK,FULL
# RUN: sed 's/RETS implicit \$s7/RET_NANO \$r6/g; s/\$s7/\$r6/g' %s | llc -x mir -mtriple=riscc -mcpu=nano \
# RUN:   -run-pass=riscc-postra-optimize -verify-machineinstrs -o - | FileCheck %s --check-prefixes=CHECK,NANO

# Native RC16 constants use LDI16, not the RC32 literal-load instruction.
# Arithmetic wraps at the native width, including on Nano.
# CHECK-LABEL: name: wrapping_constant
# CHECK: $r1 = LDI16 65530
# CHECK: ST $r1
# CHECK-NEXT: $r1 = ADDI {{(killed )?}}renamable $r1, 13
# CHECK: RET

# Nano does not have CMPI. Do not synthesize it from another register.
# CHECK-LABEL: name: other_register
# CHECK: $r2 = LDI16 700
# FULL-NEXT: CMPI {{(killed )?}}renamable $r2, -7, implicit-def $r0
# NANO-NEXT: $r0 = LDI16 707
# CHECK: RET

--- |
  target triple = "riscc-none-elf"
  define void @wrapping_constant() optsize { ret void }
  define void @other_register() optsize { ret void }
...
---
name: wrapping_constant
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $s7
    $r1 = LDI16 65530
    ST $r1, $r3, 0 :: (store (s16))
    $r1 = LDI16 7
    RETS implicit $s7, implicit $r1
...
---
name: other_register
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $s7
    $r2 = LDI16 700
    $r0 = LDI16 707
    RETS implicit $s7, implicit $r0, implicit $r2
...
