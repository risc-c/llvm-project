    $r2 = COPY $r1
    $r1 = LD %stack.1, 0 :: (load (s16) from %stack.1)
    early-clobber $r2, $r0 = MULHU $r0, killed $r1
    $r1 = LD %stack.1, 0 :: (load (s16) from %stack.1)
    $r1 = ADDI $r1, -1
    $r0 = MOV $r1
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r3, $r4, $r5, $r6, $s7
    RETS implicit $s7, implicit $r3
