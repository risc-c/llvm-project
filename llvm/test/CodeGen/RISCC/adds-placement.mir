# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -mattr=+adds -run-pass=riscc-machine-optimize -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscc -mcpu=full -mattr=+adds -riscc-adds-placement=false -run-pass=riscc-machine-optimize -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=OFF

# The invariant's GPR lifetime ends at the entry COPY. Both loop users read
# the reserved S register, which is live through the loop and backedge.
# CHECK-LABEL: name: invariant
# CHECK: $s2 = COPY %0
# CHECK: bb.1.loop:
# CHECK: liveins: {{.*}}$s2
# CHECK: ADDS {{.*}}, $s2
# CHECK: ADDS {{.*}}, $s2
# OFF-LABEL: name: invariant
# OFF-NOT: ADDS
# OFF: RETS

--- |
  target triple = "riscc-none-elf"
  define void @invariant() {
  entry:
    br label %loop
  loop:
    br i1 undef, label %loop, label %exit
  exit:
    ret void
  }
...
---
name: invariant
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $r1, $r2, $s7
    %0:gpr = COPY $r1
    %1:gpr = COPY $r2
    %2:gpr = LDI 0
    %8:gpr = LDI 2
    %9:gpr = LDI 3
    %10:gpr = LDI 4
    %11:gpr = LDI 5
    %12:gpr = LDI 6
    %13:gpr = LDI 7
    %14:gpr = LDI 8
    JMP8 %bb.1
  bb.1.loop:
    liveins: $s7
    %3:gpr = PHI %2, %bb.0, %7, %bb.1
    %4:gpr = ADD %0, %3
    %5:gpr = ADD %3, %3
    %6:gpr = ADD %5, %0
    ST %4, %1, 0
    ST %6, %1, 2
    ST %8, %1, 4
    ST %9, %1, 6
    ST %10, %1, 8
    ST %11, %1, 10
    ST %12, %1, 12
    ST %13, %1, 14
    ST %14, %1, 16
    %7:gpr = ADDI %3, 1
    CMPI %7, 10, implicit-def $r0
    BNEZ %bb.1, implicit $r0
    JMP8 %bb.2
  bb.2.exit:
    liveins: $s7
    RETS implicit $s7
...
