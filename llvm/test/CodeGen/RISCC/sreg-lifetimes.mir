# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc-none-elf -mcpu=full -run-pass=riscc-sreg-allocator,prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

# A clobber outside both lifetimes does not prevent reusing caller-saved S2.
# CHECK-LABEL: name: around_call
# CHECK: $s2 = MTS $r1
# CHECK: $r1 = MFS $s2
# CHECK: CALL $r2, csr_riscc
# CHECK: $s2 = MTS $r1
# CHECK: $r1 = MFS $s2

# Overlapping values must get different registers, including a dead store
# to a slot whose earlier value was read already.
# CHECK-LABEL: name: overlapping
# CHECK: $s2 = MTS $r1
# CHECK: $s3 = MTS $r1
# CHECK: $r1 = MFS $s2
# CHECK: $s2 = MTS $r1
# CHECK: $r1 = MFS $s3

# A value carried around a backedge crosses the call in the next iteration.
# CHECK-LABEL: name: loop_carried
# CHECK: $s5 = MTS $r1
# CHECK: bb.1.loop:
# CHECK: liveins: {{.*}}$s5
# CHECK: CALL $r2, csr_riscc
# CHECK: $r1 = MFS $s5
# CHECK: $s5 = MTS $r1

--- |
  target triple = "riscc-none-elf"
  define void @around_call() { ret void }
  define void @overlapping() { ret void }
  define void @loop_carried() {
  entry:
    br label %loop
  loop:
    br label %loop
  }
...
---
name: around_call
tracksRegLiveness: true
noVRegs: true
frameInfo:
  hasCalls: true
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
  - { id: 1, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1, $r2
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    CALL $r2, csr_riscc, implicit-def $r1
    ST $r1, %stack.1, 0 :: (store (s16) into %stack.1)
    $r1 = LD %stack.1, 0 :: (load (s16) from %stack.1)
    RETS implicit $s7, implicit $r1
...
---
name: overlapping
tracksRegLiveness: true
noVRegs: true
frameInfo:
  hasCalls: true
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
  - { id: 1, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    ST $r1, %stack.1, 0 :: (store (s16) into %stack.1)
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    $r1 = LD %stack.1, 0 :: (load (s16) from %stack.1)
    RETS implicit $s7, implicit $r1
...
---
name: loop_carried
tracksRegLiveness: true
noVRegs: true
frameInfo:
  hasCalls: true
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
  - { id: 1, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
  bb.1.loop:
    liveins: $r2
    successors: %bb.1
    CALL $r2, csr_riscc, implicit-def $r2
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
...
