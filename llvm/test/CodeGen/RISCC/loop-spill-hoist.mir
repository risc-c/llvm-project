# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc-none-elf -mcpu=full -riscc-loop-spill-hoist -riscc-loop-spill-promotion=false \
# RUN:   -run-pass=riscc-sreg-allocator -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/\bLD\b/LD32/g' -e 's/\bST\b/ST32/g' -e 's/\bFRAMEADDR\b/FRAMEADDR32/g' -e 's/size: 2/size: 4/g' \
# RUN:   -e 's/alignment: 2/alignment: 4/g' -e 's/(s16)/(s32)/g' %s | llc -x mir -mtriple=riscc-none-elf -mcpu=full \
# RUN:   -mattr=+rc32 -riscc-loop-spill-hoist -riscc-loop-spill-promotion=false -run-pass=riscc-sreg-allocator \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# A hot self-loop has an immutable private spill reloaded several times.  R1
# is live through the loop but otherwise unused, so the pass can borrow it.
# The saved R1 slot may itself be promoted by the ordinary S-register pass.
# CHECK-LABEL: name: hoist_invariant
# CHECK:       bb.0.entry:
# CHECK:       {{(ST(32)?( killed)? \$r1, %stack\.[1-9]|\$s[2-6] = MTS( killed)? \$r1)}}
# CHECK:       {{(LD(32)?( killed)? \$r1, %stack\.0|\$r1 = MFS \$s[2-6])}}
# CHECK:       bb.1.loop:
# CHECK-NOT:   LD{{(32)?}} {{.*}}%stack.0
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r1, $r4
# CHECK:       bb.2.exit:
# CHECK:       {{(LD(32)?( killed)? \$r1, %stack\.[1-9]|\$r1 = MFS \$s[2-6])}}
# CHECK:       RETS implicit $s7, implicit {{(killed )?}}$r1

# A reload destination that is live into the exit needs an explicit copy from
# the borrowed invariant value before the borrowed register is restored.
# CHECK-LABEL: name: hoist_reload_liveout
# CHECK:       bb.1.loop:
# CHECK-NOT:   LD{{(32)?}} {{.*}}%stack.0
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r1, $r4
# CHECK:       bb.2.exit:
# CHECK:       $r2 = COPY {{(killed )?}}$r1
# CHECK:       {{(LD(32)?( killed)? \$r1, %stack\.[1-9]|\$r1 = MFS \$s[2-6])}}
# CHECK:       RETS implicit $s7, implicit {{(killed )?}}$r1, implicit {{(killed )?}}$r2

# A donor used in the loop cannot be borrowed.  The spill may still be
# promoted to an S register, but arithmetic must keep its reload destination.
# CHECK-LABEL: name: donor_used
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4
# CHECK:       bb.2.exit:

# An exit with another predecessor is not a dedicated exit.
# CHECK-LABEL: name: no_dedicated_exit
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4
# CHECK:       bb.3.exit:

# A store to the slot makes the loop spill mutable.
# CHECK-LABEL: name: modified_spill
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4

# A tied reload use is deliberately rejected.
# CHECK-LABEL: name: tied_use
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK:       $r2 = ADDI{{(32)?}} {{(killed )?}}$r2, 1
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4

# An implicit branch use is also an observation of the reload destination.
# CHECK-LABEL: name: implicit_branch_use
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK:       BNEZ %bb.1, implicit {{(killed )?}}$r0
# CHECK-NOT:   $r1
# CHECK:       JMP8 %bb.2

# Calls reject the whole loop before considering spill candidates.
# CHECK-LABEL: name: call_in_loop
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK:       CALL
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4

# Size optimization disables the profitability-changing transform.
# CHECK-LABEL: name: optsize_loop
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4

# With a cold backedge, the save/restore cost is not repaid by one reload.
# CHECK-LABEL: name: cold_backedge
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4

# A spill address used outside the loop can escape and alias a loop store.
# CHECK-LABEL: name: escaped_spill
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4

# A reload destination already live into the loop is not private to the spill.
# CHECK-LABEL: name: reload_dst_livein
# CHECK-NOT:   %stack.1
# CHECK:       bb.1.loop:
# CHECK-NOT:   ADD{{(32)?}} {{.*}}$r1, $r4
# CHECK:       $r3 = ADD{{(32)?}} {{(killed )?}}$r2, $r4

--- |
  target triple = "riscc-none-elf"
  define void @hoist_invariant() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @hoist_reload_liveout() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @donor_used() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @no_dedicated_exit() {
  entry: br label %loop
  loop: br label %exit
  alt: br label %exit
  exit: ret void
  }
  define void @modified_spill() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @tied_use() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @implicit_branch_use() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @call_in_loop() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @optsize_loop() optsize {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @cold_backedge() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @escaped_spill() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
  define void @reload_dst_livein() {
  entry: br label %loop
  loop: br label %exit
  exit: ret void
  }
...
---
name: hoist_invariant
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: hoist_reload_liveout
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1, $r2
    RETS implicit $s7, implicit $r1, implicit $r2
...
---
name: donor_used
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r1, $r4
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: no_dedicated_exit
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop, %bb.2.alt
    BNEZ %bb.2.alt, implicit $r0
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.3.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.3.exit
  bb.2.alt:
    successors: %bb.3.exit
    JMP8 %bb.3.exit
  bb.3.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: modified_spill
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: tied_use
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r2 = ADDI $r2, 1
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: implicit_branch_use
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r0 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: call_in_loop
tracksRegLiveness: true
noVRegs: true
frameInfo:
  hasCalls: true
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1, $r5
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4, $r5
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    CALL $r5, csr_riscc, implicit-def $s7, implicit-def $r0
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: optsize_loop
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: cold_backedge
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4
    successors: %bb.1.loop(0x10000000), %bb.2.exit(0x70000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: escaped_spill
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    $r5 = FRAMEADDR %stack.0, 0
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r4, $r5
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    ST $r0, $r5, 0 :: (store (s16))
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
---
name: reload_dst_livein
tracksRegLiveness: true
noVRegs: true
frameInfo:
  maxAlignment: 2
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1
    successors: %bb.1.loop
    ST $r0, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $r1, $r2, $r4
    successors: %bb.1.loop(0x7f000000), %bb.2.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r3 = ADD $r2, $r4
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.2.exit
  bb.2.exit:
    liveins: $r1
    RETS implicit $s7, implicit $r1
...
