# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-postra-optimize -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/ADDI/ADDI32/g' -e 's/MOV/MOV32/g' -e 's/\bST\b/ST32/g' %s | llc -x mir -mtriple=riscc -mcpu=full \
# RUN:   -mattr=+rc32 -run-pass=riscc-postra-optimize -verify-machineinstrs -o - | FileCheck %s

# This is arithmetic folding, independent of a following comparison.
# CHECK-LABEL: name: difference
# CHECK: CMPI{{(32)?}} {{(killed )?}}$r1, 37, implicit-def $r0
# CHECK-NEXT: RETS
---
name: difference
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r1, $s7
    $r0 = MOV $r1
    $r0 = ADDI $r0, -37
    RETS implicit $s7, implicit $r0
...
# CHECK-LABEL: name: independent_work
# CHECK: ST{{(32)?}} $r2, $r3, 0
# CHECK-NEXT: CMPI{{(32)?}} {{(killed )?}}$r1, -127, implicit-def $r0
# CHECK-NEXT: RETS
---
name: independent_work
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r1, $r2, $r3, $s7
    $r0 = MOV $r1
    ST $r2, $r3, 0
    $r0 = ADDI $r0, 127
    RETS implicit $s7, implicit $r0, implicit $r2, implicit $r3
...
# +128 is not a signed byte CMPI operand.
# CHECK-LABEL: name: unencodable
# CHECK: $r0 = MOV{{(32)?}} $r1
# CHECK-NEXT: $r0 = ADDI{{(32)?}} $r0, -128
---
name: unencodable
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r1, $s7
    $r0 = MOV $r1
    $r0 = ADDI $r0, -128
    RETS implicit $s7, implicit $r0
...
# CHECK-LABEL: name: observed_copy
# CHECK: $r0 = MOV{{(32)?}} $r1
# CHECK: ST{{(32)?}} $r0, $r2, 0
# CHECK: $r0 = ADDI{{(32)?}} $r0, -7
---
name: observed_copy
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r0 = MOV $r1
    ST $r0, $r2, 0
    $r0 = ADDI $r0, -7
    RETS implicit $s7, implicit $r0
...
# CHECK-LABEL: name: changed_source
# CHECK: $r0 = MOV{{(32)?}} $r1
# CHECK: $r1 = ADDI{{(32)?}} $r1, 1
# CHECK: $r0 = ADDI{{(32)?}} $r0, -7
---
name: changed_source
tracksRegLiveness: true
noVRegs: true
body: |
  bb.0:
    liveins: $r1, $s7
    $r0 = MOV $r1
    $r1 = ADDI $r1, 1
    $r0 = ADDI $r0, -7
    RETS implicit $s7, implicit $r0, implicit $r1
...
