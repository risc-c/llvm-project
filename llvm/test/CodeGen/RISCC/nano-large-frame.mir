# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc-none-elf -mcpu=nano -run-pass=prolog-epilog %s -o - | FileCheck %s

# A Nano return may keep the incoming link in r0. r0 is not an argument
# register, so large-frame setup may use it directly; teardown uses r6 to
# preserve the return target.
# CHECK-LABEL: name: return_link_in_r0
# CHECK:       $r0 = frame-setup LDI16 302
# CHECK-NEXT:  $r7 = frame-setup SUB $r7, $r0
# CHECK:       $r6 = frame-destroy LDI16 302
# CHECK-NEXT:  $r7 = frame-destroy ADD $r7, $r6
# CHECK-NEXT:  RET_NANO killed $r0

--- |
  target triple = "riscc-none-elf"

  define void @return_link_in_r0() {
  entry:
    ret void
  }
...
---
name:            return_link_in_r0
alignment:       2
tracksRegLiveness: true
noVRegs:         true
frameInfo:
  maxAlignment:  2
stack:
  - { id: 0, name: '', type: default, offset: 0, size: 300, alignment: 2,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true }
body:             |
  bb.0.entry:
    liveins: $r0

    RET_NANO killed $r0
...
