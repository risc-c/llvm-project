# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-sreg-allocator -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscc -mcpu=min -run-pass=riscc-sreg-allocator,prolog-epilog -verify-machineinstrs %s -o - | FileCheck %s

# A cached spill's debug location must not reference the deleted stack slot.
# CHECK-LABEL: name: spill_across_blocks
# CHECK:       stack: []
# CHECK:       $s2 = MTS killed $r1
# CHECK-NEXT:  DBG_VALUE $noreg, 0,
# CHECK:       bb.2:
# CHECK:       $r1 = MFS $s2

--- |
  define i16 @spill_across_blocks(i16 %v) !dbg !4 { ret i16 %v }
  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "test", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "spill.c", directory: "/")
  !2 = !DISubroutineType(types: !{})
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "spill_across_blocks", scope: !1, file: !1, line: 1, type: !2, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0)
  !5 = !DILocalVariable(name: "v", scope: !4, file: !1, line: 1, type: !6)
  !6 = !DIBasicType(name: "short", size: 16, encoding: DW_ATE_signed)
  !7 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name: spill_across_blocks
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    successors: %bb.1
    liveins: $r1, $s7
    ST killed $r1, %stack.0, 0
    DBG_VALUE %stack.0, 0, !5, !DIExpression(), debug-location !7
    JMP8 %bb.1
  bb.1:
    successors: %bb.2
    liveins: $s7
    JMP8 %bb.2
  bb.2:
    liveins: $s7
    $r1 = LD %stack.0, 0
    RETS implicit $s7, implicit $r1
...
