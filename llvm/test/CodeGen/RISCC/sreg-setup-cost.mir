# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -run-pass=riscc-sreg-allocator -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/ ST / ST32 /g' -e 's/= LD /= LD32 /g' -e 's/    CALL /    CALL32 /g' -e 's/size: 2/size: 4/g' -e 's/alignment: 2/alignment: 4/g' -e 's/(s16)/(s32)/g' %s | llc -x mir -mtriple=riscc -mcpu=full -mattr=+rc32 -run-pass=riscc-sreg-allocator -verify-machineinstrs -o - | FileCheck %s

# An ordinary call leaves only callee-saved cache registers available. A
# one-shot store/reload does not repay their four save/restore instructions.
# CHECK-LABEL: name: once
# CHECK: ST{{(32)?}} $r1, %stack.0
# CHECK: CALL
# CHECK: $r1 = LD{{(32)?}} %stack.0
# CHECK-NOT: MTS
# CHECK: RETS

# A repeatedly accessed spill can amortize the fixed setup cost.
# CHECK-LABEL: name: repeated
# CHECK: $s5 = MTS $r1
# CHECK: bb.1:
# CHECK: CALL
# CHECK: $r1 = MFS $s5
# CHECK: $s5 = MTS $r1

# Size builds avoid the additional ABI save/restore text even for a hot spill.
# CHECK-LABEL: name: repeated_size
# CHECK: ST{{(32)?}} $r1, %stack.0
# CHECK: bb.1:
# CHECK: CALL
# CHECK: $r1 = LD{{(32)?}} %stack.0
# CHECK: ST{{(32)?}} $r1, %stack.0
# CHECK-NOT: MTS
# CHECK: JMP8

--- |
  define void @once() { ret void }
  define void @repeated() { br label %loop
  loop: br label %loop }
  define void @repeated_size() optsize { br label %loop
  loop: br label %loop }
...
---
name: once
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1, $r2
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    CALL $r2, csr_riscc, implicit-def $s7, implicit-def $r0
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    RETS implicit $s7, implicit $r1
...
---
name: repeated
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
  bb.1:
    liveins: $r2
    successors: %bb.1
    CALL $r2, csr_riscc, implicit-def $r2, implicit-def $s7, implicit-def $r0
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
...
---
name: repeated_size
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0:
    liveins: $r1, $r2
    successors: %bb.1
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
  bb.1:
    liveins: $r2
    successors: %bb.1
    CALL $r2, csr_riscc, implicit-def $r2, implicit-def $s7, implicit-def $r0
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    ST $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1
...
