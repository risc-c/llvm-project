# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc-none-elf -mcpu=full -riscc-loop-spill-hoist=false -run-pass=riscc-sreg-allocator \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/\bLD\b/LD32/g' -e 's/\bST\b/ST32/g' -e 's/\bADDI\b/ADDI32/g' -e 's/size: 2/size: 4/g' \
# RUN:   -e 's/alignment: 2/alignment: 4/g' -e 's/(s16)/(s32)/g' %s | llc -x mir -mtriple=riscc-none-elf -mcpu=full \
# RUN:   -mattr=+rc32 -riscc-loop-spill-promotion -riscc-loop-spill-hoist=false -run-pass=riscc-sreg-allocator \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# R2 already holds every update of a private spill in a two-block loop.
# Keep that value live across blocks instead of reloading and storing it.
# The loop's final value is dead, so it needs no exit writeback.
# CHECK-LABEL: name: dead_exit
# CHECK: bb.0.entry:
# CHECK: $r2 = {{(LD(32)? %stack.0, 0|MFS \$s[2-6])}}
# CHECK: bb.1.loop:
# CHECK-NOT: MFS
# CHECK-NOT: MTS
# CHECK-NOT: %stack.0
# CHECK: $r2 = ADDI{{(32)?}} {{(killed )?}}$r2, 1
# CHECK: bb.2.latch:
# CHECK-NOT: MFS
# CHECK-NOT: MTS
# CHECK-NOT: %stack.0
# CHECK: $r2 = ADDI{{(32)?}} {{(killed )?}}$r2, 2
# CHECK: bb.3.exit:
# CHECK-NOT: %stack.0
# CHECK: RETS

# A live spill is written back on the dedicated exit. This also applies to
# optsize, since the transformation must not add instructions overall.
# CHECK-LABEL: name: live_exit
# CHECK: bb.0.entry:
# CHECK: $r2 = {{(LD(32)? %stack.0, 0|MFS \$s[2-6])}}
# CHECK: bb.1.loop:
# CHECK-NOT: MFS
# CHECK-NOT: MTS
# CHECK-NOT: %stack.0
# CHECK: $r2 = ADDI{{(32)?}} {{(killed )?}}$r2, 1
# CHECK: bb.2.latch:
# CHECK-NOT: MFS
# CHECK-NOT: MTS
# CHECK-NOT: %stack.0
# CHECK: $r2 = ADDI{{(32)?}} {{(killed )?}}$r2, 2
# CHECK: bb.3.exit:
# CHECK: {{(ST(32)?( killed)? \$r2, %stack.0, 0|\$s[2-6] = MTS( killed)? \$r2)}}
# CHECK: $r1 = {{(LD(32)? %stack.0, 0|MFS \$s[2-6])}}
# CHECK: RETS

--- |
  target triple = "riscc-none-elf"
  define void @dead_exit() {
  entry: br label %loop
  loop: br label %latch
  latch: br label %exit
  exit: ret void
  }
  define void @live_exit() optsize {
  entry: br label %loop
  loop: br label %latch
  latch: br label %exit
  exit: ret void
  }
...
---
name: dead_exit
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1, $s7
    successors: %bb.1.loop
    ST killed $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $s7
    successors: %bb.2.latch
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r2 = ADDI killed $r2, 1
    ST killed $r2, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.2.latch
  bb.2.latch:
    liveins: $r0, $s7
    successors: %bb.1.loop(0x7f000000), %bb.3.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r2 = ADDI killed $r2, 2
    ST killed $r2, %stack.0, 0 :: (store (s16) into %stack.0)
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.3.exit
  bb.3.exit:
    liveins: $s7
    RETS implicit $s7
...
---
name: live_exit
tracksRegLiveness: true
noVRegs: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 2 }
body: |
  bb.0.entry:
    liveins: $r0, $r1, $s7
    successors: %bb.1.loop
    ST killed $r1, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.1.loop
  bb.1.loop:
    liveins: $r0, $s7
    successors: %bb.2.latch
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r2 = ADDI killed $r2, 1
    ST killed $r2, %stack.0, 0 :: (store (s16) into %stack.0)
    JMP8 %bb.2.latch
  bb.2.latch:
    liveins: $r0, $s7
    successors: %bb.1.loop(0x7f000000), %bb.3.exit(0x01000000)
    $r2 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    $r2 = ADDI killed $r2, 2
    ST killed $r2, %stack.0, 0 :: (store (s16) into %stack.0)
    BNEZ %bb.1.loop, implicit $r0
    JMP8 %bb.3.exit
  bb.3.exit:
    liveins: $s7
    $r1 = LD %stack.0, 0 :: (load (s16) from %stack.0)
    RETS implicit $s7, implicit $r1
...
