# REQUIRES: riscc-registered-target
# RUN: llc -mtriple=riscc -mcpu=full -mattr=+rc32 -run-pass=postmisched -verify-machineinstrs %s -o - | FileCheck %s
# RUN: sed -e 's/ADD32/ADD/g' -e 's/SUB32/SUB/g' -e 's/CMPI32/CMPI/g' -e 's/LD32/LD/g' -e 's/ST32/ST/g' \
# RUN:   -e 's/MUL32/MUL/g' -e 's/SRLI32/SRLI/g' %s | llc -x mir -mtriple=riscc -mcpu=full -run-pass=postmisched \
# RUN:   -verify-machineinstrs -o - | FileCheck %s

# Branches consume R0 in Execute: ordinary ALU and shift conditions need no
# filler, while a load condition leaves one useful instruction-sized gap.
# Both widths use the same timing model.
# CHECK-LABEL: name: alu
# CHECK: $r3 = ADD{{(32)?}}
# CHECK-NEXT: CMPI{{(32)?}} {{.*}}$r1, 5, implicit-def $r0
# CHECK-NEXT: BEQZ
# CHECK-LABEL: name: load
# CHECK: $r0 = LD{{(32)?}} $r1, 0
# CHECK-NEXT: $r3 = ADD{{(32)?}} $r1, $r2
# CHECK-NEXT: $r4 = SUB{{(32)?}} killed $r1, killed $r2
# CHECK-NEXT: BEQZ
# CHECK-LABEL: name: dependent
# CHECK: $r1 = ADD{{(32)?}}
# CHECK-NEXT: CMPI{{(32)?}} {{.*}}$r1, 5, implicit-def $r0
# CHECK-NEXT: BEQZ

--- |
  define void @alu() { ret void }
  define void @load() { ret void }
  define void @dependent() { ret void }
  define void @multiply() { ret void }
  define void @shift() { ret void }
...
---
name: alu
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r3 = ADD32 $r1, $r2
    CMPI32 $r1, 5, implicit-def $r0
    BEQZ %bb.1, implicit $r0
  bb.1:
    liveins: $r3, $s7
    ST32 $r3, $r7, 0
    RETS implicit $s7
...
---
name: load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r3 = ADD32 $r1, $r2
    $r4 = SUB32 $r1, $r2
    $r0 = LD32 $r1, 0
    BEQZ %bb.1, implicit $r0
  bb.1:
    liveins: $r3, $r4, $s7
    ST32 $r3, $r4, 0
    RETS implicit $s7
...

---
name: dependent
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r1 = ADD32 $r1, $r2
    CMPI32 $r1, 5, implicit-def $r0
    BEQZ %bb.1, implicit $r0
  bb.1:
    liveins: $s7
    RETS implicit $s7
...

# Multiply and shift completion save flags in Execute, just like simple ALU
# operations. They need no additional branch delay after completion.
# CHECK-LABEL: name: multiply
# CHECK: $r0 = MUL{{(32)?}}
# CHECK: BLTZ
---
name: multiply
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r3 = ADD32 $r1, $r2
    $r0 = MUL32 $r1, $r2
    BLTZ %bb.1, implicit $r0
  bb.1:
    liveins: $r3, $s7
    ST32 $r3, $r7, 0
    RETS implicit $s7
...
# CHECK-LABEL: name: shift
# CHECK: $r0 = SRLI{{(32)?}} {{.*}}$r1, 3
# CHECK: BGEZ
---
name: shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r2, $s7
    $r3 = ADD32 $r1, $r2
    $r0 = SRLI32 $r1, 3
    BGEZ %bb.1, implicit $r0
  bb.1:
    liveins: $r3, $s7
    ST32 $r3, $r7, 0
    RETS implicit $s7
...
