#--- errors.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V1, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000000000000000
  - Name: .rela.text
    Type: SHT_RELA
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 0x0
        Symbol: tagged
        Type:   R_RISCC_CODE16
      - Offset: 0x2
        Symbol: odd
        Type:   R_RISCC_CODE16
      - Offset: 0x4
        Symbol: far
        Type:   R_RISCC_PCREL8_WORD
      - Offset: 0x6
        Symbol: odd
        Type:   R_RISCC_PCREL8_WORD
  - Name:    .data
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Content: 00
Symbols:
  - Name:    tagged
    Index:   SHN_ABS
    Value:   0x10000
  - Name:    odd
    Index:   SHN_ABS
    Value:   0x101
  - Name:    far
    Index:   SHN_ABS
    Value:   0x300

#--- errors.ld
SECTIONS {
  .text 0 : { *(.text) }
  .data 0x10000 : { *(.data) }
}

#--- full.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V1, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text.full
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000

