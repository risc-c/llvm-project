#--- domains.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V1, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000
  - Name:    .refs
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Content: 000000000000000000000000000000000000000000000000
  - Name:    .rela.refs
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .refs
    Relocations:
      - Offset: 0x0
        Symbol: data
        Type:   R_RISCC_CODE16
      - Offset: 0x2
        Symbol: data
        Type:   R_RISCC_CODE_LO8
      - Offset: 0x3
        Symbol: data
        Type:   R_RISCC_CODE_HI8
      - Offset: 0x4
        Symbol: data
        Type:   R_RISCC_PCREL8_WORD
      - Offset: 0x5
        Symbol: func
        Type:   R_RISCC_ABS8
      - Offset: 0x6
        Symbol: func
        Type:   R_RISCC_ABS16
      - Offset: 0x8
        Symbol: func
        Type:   R_RISCC_ABS32
      - Offset: 0xc
        Symbol: func
        Type:   R_RISCC_LO8
      - Offset: 0xd
        Symbol: func
        Type:   R_RISCC_HI8
  - Name:    .data
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Content: 00
Symbols:
  - Name:    func
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
  - Name:    data
    Type:    STT_OBJECT
    Binding: STB_GLOBAL
    Section: .data

#--- domains-unified.ld
SECTIONS {
  .text 0 : { *(.text) }
  .refs 0x20 : { *(.refs) }
  .data 0x100 : { *(.data) }
}

#--- domains-split.ld
SECTIONS {
  .text 0 : { *(.text) }
  .refs 0x20 : { *(.refs) }
  .data 0x10000 : { *(.data) }
}

#--- debug.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V1, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000
  - Name:    .debug_info
    Type:    SHT_PROGBITS
    Content: 0000
  - Name:    .rela.debug_info
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .debug_info
    Relocations:
      - Offset: 0x0
        Symbol: func
        Type:   R_RISCC_ABS16
Symbols:
  - Name:    func
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text

#--- debug.ld
SECTIONS {
  .text 0x100 : { *(.text) }
  .debug_info 0 : { *(.debug_info) }
}

#--- layout.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V1, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 00000000
  - Name:    .data
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Content: 0000
Symbols:
  - Name:    _start
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
  - Name:    data_entry
    Type:    STT_OBJECT
    Binding: STB_GLOBAL
    Section: .data

#--- patch-flags.py
import struct
import sys

data = bytearray(open(sys.argv[1], "rb").read())
struct.pack_into("<I", data, 36, int(sys.argv[3], 0))
open(sys.argv[2], "wb").write(data)
