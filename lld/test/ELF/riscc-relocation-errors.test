# RELOCS-DAG: error: {{.*}}relocation R_RISCC_CODE16 cannot encode out-of-range byte address 0x10000
# RELOCS-DAG: error: {{.*}}improper alignment for relocation R_RISCC_CODE16: 0x101 is not aligned to 2 bytes
# RELOCS-DAG: error: {{.*}}relocation R_RISCC_PCREL8_WORD out of range: {{.*}} is not in [-128, 127]
# RELOCS-DAG: error: {{.*}}improper alignment for relocation R_RISCC_PCREL8_WORD: 0xFB is not aligned to 2 bytes

# ET-DYN: error: RISC-C ABI v0 does not support shared objects or
# ET-DYN-SAME: position-independent executables

# MERGED-FULL: Flags [ (0x11)
# MERGED-FULL: EF_RISCC_ABI_V0 (0x1)
# MERGED-FULL: EF_RISCC_PROFILE_FULL (0x10)

# MERGED-SYS: Flags [ (0x31)
# MERGED-SYS: EF_RISCC_ABI_V0 (0x1)
# MERGED-SYS: EF_RISCC_PROFILE_SYS (0x30)

# MISSING-ABI: error: missing-abi.o: unsupported RISC-C ABI flags 0x0 (expected ABI v0)
# UNKNOWN-ABI: error: unknown-abi.o: unsupported RISC-C ABI flags 0x2 (expected ABI v0)
# NANO: Flags [ (0x41)
# NANO: EF_RISCC_ABI_V0 (0x1)
# NANO: EF_RISCC_PROFILE_NANO (0x40)
# NANO-RC32: error: nano-rc32.o: RC32 has no Nano profile
# MIXED-NANO: error: cannot link incompatible RISC-C Nano and mainline profiles
# MIXED-CONFIG: error: cannot link RISC-C objects with different RC16, RC32, or RC32X ABIs
# RC32X: error: rc32x.o: RC32X is not implemented
# MISSING-PROFILE: error: missing-profile.o: unsupported RISC-C ISA profile flags 0x0
# UNKNOWN-PROFILE: error: unknown-profile.o: unsupported RISC-C ISA profile flags 0x50
# UNKNOWN-BITS: error: unknown-bits.o: unsupported RISC-C ELF flags 0x400

# DOMAINS: Contents of section .refs:
# DOMAINS-NEXT: 0020 00000000 db808000 80000000 80000000

# DEBUG: Contents of section .debug_info:
# DEBUG-NEXT: 0000 0001

# CODE-HIGH-DAG: error: executable section .text range {{.*}} is outside the RISC-C code byte address range [0x0, 0x10000)
# CODE-HIGH-DAG: error: entry point 0x10000 is not an aligned RISC-C code byte address in [0x0, 0x10000)
# CODE-ODD-DAG: error: executable section .text address 0x1 is not 2-byte aligned
# CODE-ODD-DAG: error: entry point 0x1 is not an aligned RISC-C code byte address in [0x0, 0x10000)
# CODE-CROSSES: error: executable section .text range {{.*}} is outside the RISC-C code byte address range [0x0, 0x10000)
# ENTRY-HIGH: error: entry point 0x10000 is not an aligned RISC-C code byte address in [0x0, 0x10000)
# ENTRY-DATA: error: entry symbol data_entry is defined in non-executable section .data

#--- errors.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V0, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000000000000000
  - Name: .rela.text
    Type: SHT_RELA
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 0x0
        Symbol: tagged
        Type:   R_RISCC_CODE16
      - Offset: 0x2
        Symbol: odd
        Type:   R_RISCC_CODE16
      - Offset: 0x4
        Symbol: far
        Type:   R_RISCC_PCREL8_WORD
      - Offset: 0x6
        Symbol: odd
        Type:   R_RISCC_PCREL8_WORD
  - Name:    .data
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_WRITE ]
    Content: 00
Symbols:
  - Name:    tagged
    Index:   SHN_ABS
    Value:   0x10000
  - Name:    odd
    Index:   SHN_ABS
    Value:   0x101
  - Name:    far
    Index:   SHN_ABS
    Value:   0x300

#--- errors.ld
SECTIONS {
  .text 0 : { *(.text) }
  .data 0x10000 : { *(.data) }
}

#--- full.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V0, EF_RISCC_PROFILE_FULL ]
Sections:
  - Name:    .text.full
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000

