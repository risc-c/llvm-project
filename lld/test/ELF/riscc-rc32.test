#--- jall.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_RISCC
  Flags:   [ EF_RISCC_ABI_V0, EF_RISCC_PROFILE_SYS, EF_RISCC_RC32 ]
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 34380000
  - Name:    .rela.text
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .text
    Relocations:
      - Offset: 0x0
        Symbol: target
        Type:   R_RISCC_JALL21
  - Name:    .target
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000
Symbols:
  - Name:    _start
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
  - Name:    target
    Type:    STT_FUNC
    Binding: STB_GLOBAL
    Section: .target

#--- jall.ld
SECTIONS {
  .text 0 : { *(.text) }
  .target 0x10000 : { *(.target) }
}

