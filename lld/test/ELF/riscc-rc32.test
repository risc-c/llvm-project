  - Name:    .rela.text
    Type:    SHT_RELA
    Link:    .symtab
    Info:    .text
    Relocations:
      - Offset: 0x0
        Symbol: target
        Type:   R_RISCC_CODE16
  - Name:    .target
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Content: 0000
Symbols:
